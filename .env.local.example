# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=     # Direct connection: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Anthropic
# Optional. Leave empty for the Basic app without AI features.
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated platform admins allowed to access /admin.
SUPERADMIN_EMAILS=brahimsemlali20@gmail.com

# Email (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ArchiDesk <noreply@archidesk.ma>

# Billing (LemonSqueezy — hosted checkout + webhook sync)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_STUDIO_VARIANT_ID=
LEMON_SQUEEZY_AGENCE_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true

# Push Notifications (VAPID — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@archidesk.ma

# Cron jobs (Vercel Cron calls /api/notifications/cron with this secret header)
CRON_SECRET=

# Error monitoring (Sentry) — optional; inert until NEXT_PUBLIC_SENTRY_DSN is set
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI/prod only):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
